# Kopier til .env.local for lokal utvikling. Legg de samme verdiene inn i Vercel
# (Settings → Environment Variables). Commit aldri ekte verdier.

# --- Supabase (fase 1) ---------------------------------------------------------
# Bruker du Supabase-integrasjonen i Vercel, legges disse inn automatisk, og da heter de
# NEXT_PUBLIC_SUPABASE_ANON_KEY og SUPABASE_SERVICE_ROLE_KEY. Begge navnene virker.
# Ellers: Project Settings → API Keys. «Publishable key» (sb_publishable_…) eller anon-nøkkelen.
NEXT_PUBLIC_SUPABASE_URL=https://ditt-prosjekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# «Secret key» (sb_secret_…) eller service_role. KUN server – omgår RLS.
SUPABASE_SECRET_KEY=

# Innlogging er av som standard (appen åpnes rett inn). Sett til true for å kreve innlogging.
AUTH_ENABLED=false

# Brukes i innloggingslenker. Lokalt: http://localhost:3000. I Vercel: https://<ditt-domene>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Outlook-synk (fase 3) -----------------------------------------------------
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32 – Vercel sender denne som Bearer-token til cron-rutene
CRON_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_AUTHORITY=https://login.microsoftonline.com/consumers
# openssl rand -hex 32
OUTLOOK_WEBHOOK_CLIENT_STATE=

# --- Vær (fase 5) --------------------------------------------------------------
# Valgfri. User-Agent mot api.met.no har alltid GitHub-lenken som kontaktinfo (holder etter vilkårene);
# settes denne, legges e-postadressen til i tillegg.
MET_CONTACT_EMAIL=

# --- Filinnlesning (fase 7) ----------------------------------------------------
# Fra console.anthropic.com → API Keys. Kun server.
ANTHROPIC_API_KEY=
# Valgfri. Tom = claude-opus-5-5
ANTHROPIC_MODEL=
